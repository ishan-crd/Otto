# ─────────────────────────────────────────────────────────────
# Otto — environment. Copy to `.env` and fill in.
# Everything works in RAIL=mock with ZERO config. Only switch to
# RAIL=algorand once you've funded a testnet wallet (see SETUP.md).
# ─────────────────────────────────────────────────────────────

PORT=8787

# "mock"     -> instant, offline, no blockchain. Use this to build the whole app + frontend.
# "algorand" -> real USDC settlement on Algorand testnet. Use for the go/no-go dry run + the real demo.
RAIL=mock

# Budgets (the Spend Firewall). Values are in USDC.
DEFAULT_TASK_BUDGET_USDC=0.10
SESSION_BUDGET_USDC=1.00

# ── Only needed when RAIL=algorand ───────────────────────────
# Free public testnet node (no token needed with Algonode):
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=

# Algorand TestNet USDC ASA id (verify in SETUP.md before relying on it):
USDC_ASSET_ID=10458941

# The wallet Otto pays FROM — an ALGORAND account's 25-word mnemonic (space
# separated). NOT MetaMask (that's Ethereum). Generate one with `npm run gen-wallet`,
# or export from Pera/Defly/Lute. TestNet only — NEVER commit a real mnemonic.
PAYER_MNEMONIC=

# The wallet Otto receives INTO (its "earnings" account) — an Algorand TestNet
# address OPTED IN to the USDC ASA. This is the ONLY thing the live /pay wallet
# flow needs (the user's Pera wallet is the payer; no server key required).
# Set this + restart → http://localhost:8787/pay goes live. Works with RAIL=mock.
RECEIVER_ADDRESS=

# x402 facilitator (verifies + settles). Confirm the exact request shape during the dry run.
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Explorer base used to build clickable receipt links:
EXPLORER_TX_BASE=https://lora.algokit.io/testnet/transaction/

# ── Real work behind the x402 paywall ───────────────────────
# The paid endpoints /live/services/ask and /live/services/translate make REAL
# OpenRouter calls (cheap per call) — genuine AI agent work you pay for. Get a
# key at https://openrouter.ai/keys. Without it those two return a clear error
# and DON'T charge; the price + weather endpoints work with no key (free public
# APIs). So paying an Otto endpoint returns a real, live result.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
